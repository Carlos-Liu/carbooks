# Copy to .env and adjust before running docker compose.
# .env is git-ignored: never commit real credentials.

# PostgreSQL
POSTGRES_DB=carbooks
POSTGRES_USER=carbooks
POSTGRES_PASSWORD=change-me

# Seq initial admin password
SEQ_ADMIN_PASSWORD=change-me

# Host ports
WEB_PORT=8080
SEQ_PORT=8341
DASHBOARD_PORT=18888

# Image tag applied to the locally built images
CARBOOKS_VERSION=latest
